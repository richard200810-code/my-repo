---
import { loadPageSEO, sitemapIDs } from '@/lib/seo-data';
import { MANAGED_META, pageSEOTags, sitemapXML } from '@/lib/seo';
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

// Wix reserves its default sitemap routes; serve the supplemental map explicitly.
if (Astro.url.pathname === '/sitemap-index.xml') {
  try {
    const [products, stores] = await Promise.all([sitemapIDs('hairextensions'), sitemapIDs('stores')]);
    return new Response(sitemapXML(products, stores), { headers: { 'Content-Type': 'application/xml; charset=utf-8', 'Cache-Control': 'public, max-age=300' } });
  } catch {
    return new Response('Sitemap temporarily unavailable', { status: 503, headers: { 'Retry-After': '300' } });
  }
}
const pageSEO = await loadPageSEO(Astro.url.pathname);
const seoTagsServiceConfig = await loadSEOTagsServiceConfig({
  pageUrl: pageSEO.canonical,
  itemData: {
    pageName: pageSEO.title.split(' | ')[0],
  },
});
seoTagsServiceConfig.tags = [...seoTagsServiceConfig.tags.filter(tag => tag.type !== 'title' && tag.props?.rel !== 'canonical' && !MANAGED_META.includes(tag.props?.name || tag.props?.property)), ...pageSEOTags(pageSEO)];
---

<html lang="es-MX" class="w-full h-full">
  <head>
    <Head />
    <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
